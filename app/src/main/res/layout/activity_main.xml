<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="visible"
    tools:context=".MainActivity">

    <ListView
        android:id="@+id/devicesListView"
        android:layout_width="405dp"
        android:layout_height="330dp"


        android:layout_marginTop="4dp"
        android:choiceMode="singleChoice"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/LinearLayout01"
        tools:layout_editor_absoluteX="0dp"
        tools:ignore="MissingConstraints" />

    <LinearLayout
        android:id="@+id/LinearLayout01"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:layout_alignParentBottom="true"
        android:background="@color/colorPrimary"
        android:padding="10dp"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="0dp"
        tools:ignore="MissingConstraints">

        <Button
            android:id="@+id/scan"
            android:layout_width="55dp"
            android:layout_height="54dp"
            android:layout_marginLeft="20dp"
            android:background="@drawable/bluetoothoff"
            android:padding="15dp" />

        <Button
            android:id="@+id/PairedBtn"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginLeft="50dp"
            android:background="@drawable/buttonshape"
            android:padding="15dp" />

        <Button
            android:id="@+id/discover"
            android:layout_width="64dp"
            android:layout_height="62dp"
            android:layout_marginLeft="50dp"
            android:background="@drawable/bluetooth_finder"
            android:padding="15dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/outLayout"
        android:layout_width="match_parent"
        android:layout_height="326dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/LinearLayout01"
        tools:layout_editor_absoluteX="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn1"
                style="@style/Widget.AppCompat.Button"
                android:layout_width="70dp"
                android:layout_height="82dp"
                android:background="@drawable/custom_button"
                android:padding="15dp"
                android:text="1" />

            <Button
                android:id="@+id/btn2"
                android:layout_width="70dp"
                android:layout_height="82dp"
                android:layout_marginLeft="60dp"
                android:background="@drawable/custom_button"
                android:padding="15dp"
                android:text="2" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn3"
                android:layout_width="70dp"
                android:layout_height="82dp"
                android:background="@drawable/custom_button"
                android:padding="15dp"
                android:text="3" />

            <Button
                android:id="@+id/btn4"
                android:layout_width="70dp"
                android:layout_height="82dp"
                android:layout_marginLeft="60dp"
                android:background="@drawable/custom_button"
                android:padding="15dp"
                android:text="4" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn5"
                android:layout_width="70dp"
                android:layout_height="82dp"
                android:background="@drawable/custom_button"
                android:padding="15dp"
                android:text="5" />

            <Button
                android:id="@+id/btn6"
                android:layout_width="70dp"
                android:layout_height="82dp"
                android:layout_marginLeft="60dp"
                android:background="@drawable/custom_button"
                android:padding="15dp"
                android:text="6" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn7"
                android:layout_width="70dp"
                android:layout_height="82dp"
                android:background="@drawable/custom_button"
                android:padding="15dp"
                android:text="7" />

            <Button
                android:id="@+id/btn8"
                android:layout_width="70dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="60dp"
                android:background="@drawable/custom_button"

                android:padding="15dp"
                android:text="8" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/textView"
        android:layout_width="45dp"
        android:layout_height="20dp"
        android:layout_marginTop="20dp"
        android:text="Status"
        android:textColor="@android:color/black"
        app:layout_constraintTop_toBottomOf="@+id/outLayout"
        tools:layout_editor_absoluteX="3dp" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="117dp"
        android:layout_height="22dp"
        android:layout_marginTop="80dp"
        android:paddingLeft="20dp"
        android:text="Bluetooth ON"
        android:textColor="@android:color/background_dark"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/LinearLayout01" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="138dp"
        android:layout_height="23dp"
        android:layout_marginStart="92dp"
        android:layout_marginTop="80dp"
        android:paddingLeft="30dp"
        android:text="Paired Devices"
        android:textColor="@android:color/black"
        app:layout_constraintStart_toStartOf="@+id/textView3"
        app:layout_constraintTop_toTopOf="@+id/LinearLayout01" />

    <TextView
        android:id="@+id/textView6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="100dp"
        android:layout_marginTop="80dp"
        android:paddingLeft="40dp"
        android:text="Discover Devices"
        android:textColor="@android:color/black"
        app:layout_constraintStart_toStartOf="@+id/textView5"
        app:layout_constraintTop_toTopOf="@+id/LinearLayout01" />

    <TextView
        android:id="@+id/bluetoothStatus"
        android:layout_width="314dp"
        android:layout_height="21dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="457dp"
        android:text="Bluetooth Status"
        app:layout_constraintStart_toEndOf="@+id/textView"
        app:layout_constraintTop_toTopOf="@+id/LinearLayout01" />

</androidx.constraintlayout.widget.ConstraintLayout>